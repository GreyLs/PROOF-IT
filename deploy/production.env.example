# Use the actual DNS name and mail provider before deployment.
PUBLIC_HOST=talent.example.com
BASE_URL=https://talent.example.com
SMTP_HOST=smtp.example.com
SMTP_FROM=talent@example.com
SMTP_USER=replace_with_provider_user
OLLAMA_MODEL=qwen3:8b
FSP_REQUIRE_GPU=true
FSP_GPU_MIN_OFFLOAD_PERCENT=100
# Address plan for the private gateway network; avoid collisions on the VM.
FRONT_SUBNET=172.30.10.0/24
GATEWAY_IP=172.30.10.2
API_IP=172.30.10.3
