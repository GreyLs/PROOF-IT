DATABASE_URL=postgresql://fsp_app:CHANGE_ME@127.0.0.1:55432/fsp_trajectory
# Small local dataset: avoid Windows parallel-query process startup overhead.
DATABASE_PARALLEL_WORKERS=0
FSP_DEMO_MODE=true
BIND_ADDR=127.0.0.1:80
BASE_URL=http://127.0.0.1
STORAGE_DIR=runtime/storage
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
FSP_REQUIRE_GPU=true
FSP_GPU_MIN_OFFLOAD_PERCENT=100
# Keep the verified local model resident while the platform is running.
FSP_OLLAMA_KEEP_ALIVE=-1m
FSP_FORECAST_URL=http://127.0.0.1:8090
WORKBENCH_URL=http://127.0.0.1:8091
INTELLIGENCE_URL=http://127.0.0.1:8092
FSP_OIDC_ISSUER=
FSP_OIDC_CLIENT_ID=proofit
FSP_OIDC_CLIENT_SECRET=
# Optional shared compute cache; sessions/revocation remain authoritative in PG.
# REDIS_URL=redis://127.0.0.1:6379/0
VACANCY_MODEL=qwen2.5:3b
CODE_REVIEW_MODEL=gpt-oss:20b
CODE_REVIEW_OLLAMA_URL=http://127.0.0.1:11435
DOCUMENT_WORKERS=1
# Windows only; on Linux tesseract is found on PATH.
TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
# Required when FSP_DEMO_MODE=false:
# SMTP_HOST=smtp.example.org
# SMTP_FROM=trajectory@example.org
# SMTP_USER=
# SMTP_PASSWORD=
